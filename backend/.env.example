DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/queryscope
APP_NAME=QueryScope
DEBUG=false
AZURE_SEARCH_ENDPOINT=https://queryscope-search.search.windows.net
AZURE_SEARCH_KEY=your-admin-key-here
AZURE_SEARCH_INDEX=benchmark-runs
OPENAI_API_KEY=<your-openai-api-key>

# Access control. Auth is ON by default (fail closed).
# Local development: set AUTH_ENABLED=false and ignore the three secrets below.
AUTH_ENABLED=true
# Each must be a random string of 32+ characters, e.g. from: openssl rand -hex 32
SESSION_SECRET=
CODE_PEPPER=
ADMIN_API_KEY=
# Hosted only: number of trusted proxy hops in front of the app (see config.py).
TRUSTED_PROXY_HOPS=0

# --- Guardrails (hosted demo). Every value below shows its default. ---------
# Hard caps, enforced in the request schemas for every client.
MAX_NUM_REQUESTS=500
MAX_CONCURRENCY=20
MAX_REQUEST_TIMEOUT_S=10
RUN_WALL_CLOCK_LIMIT_S=60
# Usage limits, computed from the runs table. Enforced only when AUTH_ENABLED=true.
MAX_CONCURRENT_RUNS=2
MAX_ACTIVE_RUNS_PER_CODE=1
DAILY_BUDGET_PER_CODE=2000
DAILY_BUDGET_GLOBAL=10000
# Runs stuck pending/running past the wall-clock limit plus this grace are marked failed.
REAPER_GRACE_SECONDS=120
REAPER_INTERVAL_SECONDS=60
# SSRF protection: refuse loopback, private, link-local, CGNAT, multicast and
# reserved targets. Keep true when hosted; false only for local development
# against localhost services.
BLOCK_PRIVATE_TARGETS=true
# Exact hostnames, comma-separated (no wildcards). Add your demo target's public
# hostname here. Enforced when AUTH_ENABLED=true unless TARGET_ALLOWLIST_ENABLED overrides it.
ALLOWED_TARGET_HOSTS=httpbin.org
# TARGET_ALLOWLIST_ENABLED=
# LLM benchmark route: off when AUTH_ENABLED=true unless set here.
# LLM_BENCHMARK_ENABLED=false
